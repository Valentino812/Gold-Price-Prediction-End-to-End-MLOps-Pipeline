name: Workflow-CI-RandomForest

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path:
        type: string
        default: data/processed/harga_emas_dan_swiss_franc_preprocessing.csv
      raw_price_path:
        type: string
        default: data/raw/XAU_USD Historical Data.csv
      output_dir:
        type: string
        default: outputs
      n_estimators:
        type: int
        default: 100
    command: "python modelling.py --data-path {data_path} --raw-price-path {raw_price_path} --output-dir {output_dir} --n-estimators {n_estimators}"
